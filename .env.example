# Docker Compose reads .env automatically. npm start uses shell environment.
# Empty PUBLIC_URL keeps LAN mode; a public origin must be HTTPS without a path.
PORT=3000
UNO_BIND_IP=0.0.0.0
UNO_ALLOWED_HOSTS=
UNO_PUBLIC_URL=
# Optional browser-visible STUN/TURN config. Do not use a private provider API key.
UNO_VOICE_ICE_SERVERS=[]
